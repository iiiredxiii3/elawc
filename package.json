{
  "name": "smartlaunch-admin-pro",
  "version": "3.0.0",
  "description": "Smartlaunch 4.8 Persian Web & Desktop Admin Panel with Built-in TCP 7831 Bridge",
  "main": "main.js",
  "bin": "standalone-server.js",
  "scripts": {
    "start": "electron .",
    "build:desktop-exe": "electron-builder --win portable --x64",
    "build:light-exe": "pkg . --targets node20-win-x64 --output dist/Smartlaunch-Light-Server.exe --compress GZip"
  },
  "pkg": {
    "scripts": [
      "standalone-server.js"
    ],
    "assets": [
      "index.html"
    ]
  },
  "build": {
    "appId": "com.redx.smartlaunch.admin",
    "productName": "Smartlaunch-Admin-Pro",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "index.html",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "portable": {
      "artifactName": "Smartlaunch-Admin-Desktop-Portable.exe"
    }
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^5.15.0",
    "electron": "^31.4.0",
    "electron-builder": "^24.13.3"
  }
}
